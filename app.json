{
  "expo": {
    "name": "moa",
    "slug": "moa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moa",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.doxmt.moa",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "스토리에 올릴 사진을 촬영합니다.",
        "NSPhotoLibraryUsageDescription": "스토리에 올릴 사진을 선택합니다.",
        "NSPhotoLibraryAddUsageDescription": "스토리 사진을 갤러리에 저장합니다."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.doxmt.moa"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "스토리에 올릴 사진을 선택합니다.",
          "cameraPermission": "스토리에 올릴 사진을 촬영합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "스토리 사진을 갤러리에 저장합니다.",
          "savePhotosPermission": "스토리 사진을 갤러리에 저장합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2f8e7c1-d67a-433b-b7bf-20fab5de2fa3"
      }
    },
    "owner": "doxmt"
  }
}
