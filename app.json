{
  "expo": {
    "name": "moa",
    "slug": "moa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moa",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moa.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "스토리 사진을 갤러리에 저장합니다.",
        "NSPhotoLibraryAddUsageDescription": "스토리 사진을 갤러리에 저장합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.moa.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "스토리 사진을 갤러리에 저장합니다.",
          "savePhotosPermission": "스토리 사진을 갤러리에 저장합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
